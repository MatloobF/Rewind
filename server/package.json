{
  "name": "rewind-server",
  "version": "0.1.0",
  "private": true,
  "description": "Rewind LLM proxy, REST API, replay engine and CLI",
  "type": "module",
  "bin": {
    "rewind": "bin/rewind.js"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../.env src/index.js",
    "start": "node --env-file-if-exists=../.env src/index.js",
    "migrate": "node --env-file-if-exists=../.env src/migrate.js",
    "test": "node --env-file-if-exists=../.env --test \"test/*.test.js\""
  },
  "dependencies": {
    "express": "^5.3.0",
    "pg": "^8.23.1"
  }
}
