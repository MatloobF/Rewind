# Copy to .env. Never commit .env.

# Postgres from docker-compose.yml
DATABASE_URL=postgres://postgres:rewind@localhost:5432/rewind

# Ollama's OpenAI-compatible API (ollama serve). No trailing /v1: the proxy
# forwards /r/:runId/v1/... to UPSTREAM_URL + /v1/...
UPSTREAM_URL=http://localhost:11434

# Anthropic-format endpoint for /r/:runId/v1/messages. Leave empty to use
# UPSTREAM_URL (Ollama serves /v1/messages too, so it stays free). For the
# real API: https://api.anthropic.com (the agent sends its own x-api-key,
# which is forwarded but never recorded).
ANTHROPIC_UPSTREAM_URL=

# Rewind server (proxy + API), used by the CLI and MCP proxy, and by the
# server to tell the agents it launches for forks where to reach it
REWIND_SERVER_URL=http://localhost:4000

# Set by the CLI for each recorded run. Leave empty when running by hand.
REWIND_RUN_ID=

# Set by the CLI. The sample agent uses this as its LLM base URL.
REWIND_BASE_URL=

# Python intel service
INTEL_URL=http://localhost:8000
